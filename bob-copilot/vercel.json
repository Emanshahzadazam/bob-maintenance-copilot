{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/analyze",  "dest": "/api/analyze.js" },
    { "src": "/api/examples", "dest": "/api/examples.js" },
    { "src": "/",             "dest": "/public/index.html" },
    { "src": "/(.*)",         "dest": "/public/$1" }
  ],
  "functions": {
    "api/analyze.js": {
      "maxDuration": 30
    }
  }
}
